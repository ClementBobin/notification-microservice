<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owns the database structure: the only project with migrations. Runs once (docker: restart "no") and exits. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*" PrivateAssets="all" />
    <ProjectReference Include="..\Genkan.Shared\Genkan.Shared.csproj" />
  </ItemGroup>
</Project>
